# Production environment - all security features enabled
VITAL_ENV=PROD

# All tool configurations (use AWS Secrets Manager for actual values)
PROD_TOOL_WEATHER_API_KEY=
PROD_TOOL_PLACE_SEARCH_API_KEY=
PROD_TOOL_GOOGLE_WEB_SEARCH_API_KEY=
PROD_TOOL_GOOGLE_ADDRESS_VALIDATION_API_KEY=
PROD_TOOL_LOOP_LOOKUP_API_KEY=
PROD_TOOL_LOOP_MESSAGE_AUTHORIZATION_KEY=
PROD_TOOL_LOOP_MESSAGE_SECRET_KEY=
PROD_TOOL_SEND_EMAIL_API_KEY=
PROD_TOOL_SEND_EMAIL_DOMAIN=
PROD_TOOL_SEND_EMAIL_FROM_EMAIL=

# RunPod
PROD_RUNPOD_API_KEY=

# JWT enabled with full validation
PROD_JWT_ENABLED=true
PROD_JWT_ALGORITHM=RS256
PROD_JWT_PUBLIC_KEY_PATH=/keys/prod_public.pem
PROD_JWT_JWKS_URL=https://auth.yourdomain.com/.well-known/jwks.json
PROD_JWT_REQUIRED_CLAIMS=sub,exp,iat
PROD_JWT_TOKEN_EXPIRY_SECONDS=3600
PROD_JWT_ISSUER=https://auth.yourdomain.com
PROD_JWT_AUDIENCE=vital-agent-api

# App settings
PROD_APP_LOG_LEVEL=INFO
PROD_APP_PORT=8008
PROD_APP_CORS_ORIGINS=https://app.yourdomain.com
