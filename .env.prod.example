# Production environment - all security features enabled
VITAL_ENV=PROD

# All tool configurations (use AWS Secrets Manager for actual values)
# Pattern: {VITAL_ENV}__TOOL__{TOOL_NAME}__{CONFIG_KEY}
PROD__TOOL__WEATHER__API_KEY=
PROD__TOOL__PLACE_SEARCH__API_KEY=
PROD__TOOL__GOOGLE_WEB_SEARCH__API_KEY=
PROD__TOOL__GOOGLE_ADDRESS_VALIDATION__API_KEY=
PROD__TOOL__LOOP_LOOKUP__API_KEY=
PROD__TOOL__LOOP_MESSAGE__AUTHORIZATION_KEY=
PROD__TOOL__LOOP_MESSAGE__SECRET_KEY=
PROD__TOOL__SEND_EMAIL__API_KEY=
PROD__TOOL__SEND_EMAIL__DOMAIN=
PROD__TOOL__SEND_EMAIL__FROM_EMAIL=

# RunPod
PROD__RUNPOD__API_KEY=

# JWT enabled with full validation
PROD__JWT__ENABLED=true
PROD__JWT__ALGORITHM=RS256
PROD__JWT__PUBLIC_KEY_PATH=/keys/prod_public.pem
PROD__JWT__JWKS_URL=https://auth.yourdomain.com/.well-known/jwks.json
PROD__JWT__REQUIRED_CLAIMS=sub,exp,iat
PROD__JWT__TOKEN_EXPIRY_SECONDS=3600
PROD__JWT__ISSUER=https://auth.yourdomain.com
PROD__JWT__AUDIENCE=vital-agent-api

# App settings
PROD__APP__LOG_LEVEL=INFO
PROD__APP__PORT=8008
PROD__APP__CORS_ORIGINS=https://app.yourdomain.com
