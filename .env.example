# =============================================================================
# VITAL AGENT RESOURCE REST - Environment Configuration
# =============================================================================
# This file demonstrates the complete configuration pattern.
# Copy to .env and fill in your actual values.

# -----------------------------------------------------------------------------
# Environment Selector (Required)
# -----------------------------------------------------------------------------
# This prefix is prepended to all configuration keys
# Common values: PROD, DEV, STAGING, LOCAL
VITAL_ENV=DEV

# -----------------------------------------------------------------------------
# Tool Configurations
# -----------------------------------------------------------------------------
# Pattern: {VITAL_ENV}__TOOL__{TOOL_NAME}__{CONFIG_KEY}

# Weather Tool
DEV__TOOL__WEATHER__API_KEY=your_weather_api_key_here
PROD__TOOL__WEATHER__API_KEY=your_prod_weather_api_key_here

# Place Search Tool (Google Places API)
DEV__TOOL__PLACE_SEARCH__API_KEY=your_google_places_api_key_here
PROD__TOOL__PLACE_SEARCH__API_KEY=your_prod_google_places_api_key_here

# Google Web Search Tool (SerpAPI)
DEV__TOOL__GOOGLE_WEB_SEARCH__API_KEY=your_serpapi_key_here
PROD__TOOL__GOOGLE_WEB_SEARCH__API_KEY=your_prod_serpapi_key_here

# Serper Web Search Tool (Serper.dev)
DEV__TOOL__SERPER_WEB_SEARCH__API_KEY=your_serper_api_key_here
PROD__TOOL__SERPER_WEB_SEARCH__API_KEY=your_prod_serper_api_key_here

# Google Address Validation Tool
DEV__TOOL__GOOGLE_ADDRESS_VALIDATION__API_KEY=your_google_address_api_key_here
PROD__TOOL__GOOGLE_ADDRESS_VALIDATION__API_KEY=your_prod_google_address_api_key_here

# Loop Lookup Tool (iMessage reachability checking)
DEV__TOOL__LOOP_LOOKUP__API_KEY=your_loop_lookup_api_key_here
PROD__TOOL__LOOP_LOOKUP__API_KEY=your_prod_loop_lookup_api_key_here

# Loop Message Tool (iMessage/SMS sending - requires two keys)
DEV__TOOL__LOOP_MESSAGE__AUTHORIZATION_KEY=your_loop_message_auth_key_here
DEV__TOOL__LOOP_MESSAGE__SECRET_KEY=your_loop_message_secret_key_here
PROD__TOOL__LOOP_MESSAGE__AUTHORIZATION_KEY=your_prod_loop_message_auth_key_here
PROD__TOOL__LOOP_MESSAGE__SECRET_KEY=your_prod_loop_message_secret_key_here

# Send Email Tool (Mailgun - requires multiple fields)
DEV__TOOL__SEND_EMAIL__API_KEY=your_mailgun_api_key_here
DEV__TOOL__SEND_EMAIL__DOMAIN=dev.yourdomain.com
DEV__TOOL__SEND_EMAIL__FROM_EMAIL=noreply@dev.yourdomain.com
PROD__TOOL__SEND_EMAIL__API_KEY=your_prod_mailgun_api_key_here
PROD__TOOL__SEND_EMAIL__DOMAIN=msg.yourdomain.com
PROD__TOOL__SEND_EMAIL__FROM_EMAIL=agent@msg.yourdomain.com

# GitHub Tools (shared credential block for github_issue_tool / github_pr_tool /
# github_actions_tool -- resolves to tool_id 'github_tool')
DEV__TOOL__GITHUB__PAT=your_github_pat_here
# owner/repo are required on every request -- no config defaults.
# ALLOWED_REPOS is the only repo boundary; an unset value denies all.
DEV__TOOL__GITHUB__ALLOWED_REPOS=your_github_org/your_scratch_repo
DEV__TOOL__GITHUB__ALLOW_WRITES=true
DEV__TOOL__GITHUB__ALLOW_PR_MERGE=false
DEV__TOOL__GITHUB__ALLOW_WORKFLOW_DISPATCH=false
# Writing repository content is a separate authority from filing an issue.
DEV__TOOL__GITHUB__ALLOW_CONTENT_WRITES=false
# Even with content writes on, committing straight to the default branch is
# opt-in again -- the intended flow is create_branch -> write -> create_pr.
DEV__TOOL__GITHUB__ALLOW_DEFAULT_BRANCH_WRITES=false
PROD__TOOL__GITHUB__PAT=your_prod_github_pat_here
PROD__TOOL__GITHUB__ALLOWED_REPOS=your_github_org/repo-a,your_github_org/repo-b
PROD__TOOL__GITHUB__ALLOW_WRITES=true
PROD__TOOL__GITHUB__ALLOW_PR_MERGE=false
PROD__TOOL__GITHUB__ALLOW_WORKFLOW_DISPATCH=false
PROD__TOOL__GITHUB__ALLOW_CONTENT_WRITES=false
PROD__TOOL__GITHUB__ALLOW_DEFAULT_BRANCH_WRITES=false

# Scratch repo for GitHub tool tests (test-only, not read by EnvConfigLoader).
# Must also be listed in DEV__TOOL__GITHUB__ALLOWED_REPOS.
GITHUB_TEST_OWNER=your_github_org
GITHUB_TEST_REPO=your_scratch_repo

# -----------------------------------------------------------------------------
# RunPod Configuration
# -----------------------------------------------------------------------------
# Pattern: {VITAL_ENV}__RUNPOD__{CONFIG_KEY}

DEV__RUNPOD__API_KEY=your_runpod_api_key_here
PROD__RUNPOD__API_KEY=your_prod_runpod_api_key_here

# -----------------------------------------------------------------------------
# JWT Authentication Configuration
# -----------------------------------------------------------------------------
# Pattern: {VITAL_ENV}__JWT__{CONFIG_KEY}

# Development JWT (disabled for local dev)
DEV__JWT__ENABLED=false
DEV__JWT__ALGORITHM=RS256
DEV__JWT__SECRET_KEY=dev_secret_key_not_used
DEV__JWT__PUBLIC_KEY_PATH=/keys/dev_public.pem
DEV__JWT__JWKS_URL=
DEV__JWT__REQUIRED_CLAIMS=sub,exp,iat
DEV__JWT__TOKEN_EXPIRY_SECONDS=7200
DEV__JWT__ISSUER=
DEV__JWT__AUDIENCE=

# Production JWT (enabled with full validation)
PROD__JWT__ENABLED=true
PROD__JWT__ALGORITHM=RS256
PROD__JWT__SECRET_KEY=
PROD__JWT__PUBLIC_KEY_PATH=/keys/prod_public.pem
PROD__JWT__JWKS_URL=https://auth.yourdomain.com/.well-known/jwks.json
PROD__JWT__REQUIRED_CLAIMS=sub,exp,iat
PROD__JWT__TOKEN_EXPIRY_SECONDS=3600
PROD__JWT__ISSUER=https://auth.yourdomain.com
PROD__JWT__AUDIENCE=vital-agent-api

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Pattern: {VITAL_ENV}__APP__{CONFIG_KEY}

# Development App Settings
DEV__APP__LOG_LEVEL=DEBUG
DEV__APP__HOST=0.0.0.0
DEV__APP__PORT=8008
DEV__APP__CORS_ORIGINS=*

# Production App Settings
PROD__APP__LOG_LEVEL=INFO
PROD__APP__HOST=0.0.0.0
PROD__APP__PORT=8008
PROD__APP__CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com