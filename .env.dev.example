# Development environment - minimal configuration
VITAL_ENV=DEV

# Only configure the tools you're actively testing
DEV_TOOL_WEATHER_API_KEY=test_key
DEV_TOOL_PLACE_SEARCH_API_KEY=test_key

# JWT disabled for local development
DEV_JWT_ENABLED=false

# App settings
DEV_APP_LOG_LEVEL=DEBUG
DEV_APP_PORT=8008

# Shared MemoryDB service: the local cardiff-redis-streams container (standalone,
# no TLS), never the deployed cluster. Leave empty to disable.
DEV__MEMORYDB__URL=redis://host.docker.internal:6381/0
DEV__MEMORYDB__SSL=false
